{
  "name": "lan-file-share",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "description": "局域网文件交互系统",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "admin": "npm run admin --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "node server/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report tmp/playwright-report",
    "test:chromium": "playwright test --project=chromium-desktop",
    "test:firefox": "playwright test --project=firefox-desktop",
    "test:webkit": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=iphone --project=mobile-android",
    "test:tablet": "playwright test --project=ipad --project=tablet-android",
    "test:homepage": "playwright test -g \"主页测试\"",
    "test:qrcode": "playwright test -g \"二维码功能\"",
    "test:admin": "playwright test -g \"管理后台\"",
    "test:upload": "playwright test -g \"文件上传\"",
    "test:download": "playwright test -g \"文件下载\"",
    "test:delete": "playwright test -g \"文件删除\"",
    "test:e2e": "playwright test -g \"完整用户流程\"",
    "test:edge": "playwright test -g \"边界情况\"",
    "test:perf": "playwright test -g \"性能测试\"",
    "build:exe": "node scripts/build-exe.mjs",
    "verify:exe": "node scripts/verify-exe.mjs",
    "release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "author": "你们喜爱的老王 (B站 @你们喜爱的老王 · GitHub @ops120)"
}
